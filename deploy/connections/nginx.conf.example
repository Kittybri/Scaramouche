# EXAMPLE ONLY. Configure a real DNS name/certificate and validate nginx -t first.
# Do not enable upstream/proxy/WAF URL or header capture for these routes.

# Per-client rate limit. Client addresses are deliberately not forwarded to the app (X-Forwarded-For is cleared
# below), so the app only sees this proxy and its own limit is one shared bucket for everybody: without this zone a
# single client could use up that bucket and block every other person's account link. Addresses stay in nginx memory.
limit_req_zone $binary_remote_addr zone=connections_per_client:1m rate=30r/m;

server {
    listen 443 ssl;
    server_name connect.example.invalid;
    ssl_certificate /etc/letsencrypt/live/connect.example.invalid/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/connect.example.invalid/privkey.pem;
    access_log off;
    error_log /dev/null crit;
    client_max_body_size 8k;

    location ~ ^/(oauth/google/(start/[^/]+|callback)|health)$ {
        limit_req zone=connections_per_client burst=10 nodelay;
        limit_req_status 429;
        proxy_pass http://127.0.0.1:8787;
        proxy_set_header Host connect.example.invalid;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-Forwarded-For "";
        proxy_cache off;
        proxy_connect_timeout 5s;
        proxy_read_timeout 30s;
    }
    location / { return 404; }
}
