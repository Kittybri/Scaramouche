# Required for live Discord conversations. Leave real credentials out of Git.
DISCORD_TOKEN=
GROQ_API_KEY=

# Optional extra Groq keys: rotated automatically when one hits its rate limit.
GROQ_API_KEY_2=
GROQ_API_KEY_3=
# Optional comma-separated model lists, tried in order. When Groq retires a model the next one is used.
# GROQ_MODELS=llama-3.3-70b-versatile,openai/gpt-oss-120b,openai/gpt-oss-20b,llama-3.1-8b-instant
# GROQ_VISION_MODELS=meta-llama/llama-4-scout-17b-16e-instruct,meta-llama/llama-4-maverick-17b-128e-instruct

# Optional services and coordination. Zero disables the identity-specific setting.
FISH_AUDIO_API_KEY=
# FISH_VOICE_ID=
# FISH_AUDIO_MODEL=s2-pro
# Image descriptions use xAI when a key is set, Groq vision otherwise.
XAI_API_KEY=
# XAI_VISION_MODEL=grok-2-vision-1212
# XAI_BASE_URL=https://api.x.ai/v1
OWNER_ID=0
PARTNER_BOT_ID=0

# Optional behaviour
# BOT_TIMEZONE=America/Los_Angeles   # timezone for channel-wide timing; each person sets their own with !timezone
# MESSAGE_RETENTION_DAYS=0           # delete conversation history older than this many days (0 = keep forever)
# DATA_DIR=                          # where the SQLite files live (default: /data if it exists, else this folder)
# NWS_USER_AGENT=your-bot/1.0 (contact: you@example.com)
# LOG_LEVEL=INFO
# LOAD_PARENT_ENV=1                  # also read the .env one folder up (a checkout shared with another bot); off by default
# DOC_WORKER_MEMORY_MB=1024         # memory ceiling of the process that opens uploaded documents (!tedtalk)
# DOC_WORKER_CPU_SECONDS=30          # its CPU-time ceiling
# DOC_WORKER_TIMEOUT_SECONDS=40      # and the wall-clock limit before it is killed
